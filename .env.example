# Copy to .env.local, or just run `npm run setup` and it writes this file for you.
# Lines marked (required) must be filled in. Everything else is optional.

# Supabase (required): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security, so never share it or prefix it with NEXT_PUBLIC_. (required)
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `npm run setup`, `migrate` and `backup`. Not needed on Vercel.
# Supabase > Connect > Session pooler connection string, with your database password filled in.
DATABASE_URL=

# Shop
NEXT_PUBLIC_SHOP_NAME=Repair Bench
# IANA time zone used for dates and "today" on the dashboard, e.g. America/Chicago
NEXT_PUBLIC_TIMEZONE=America/New_York
# Sales tax % pre-filled on new invoices (0 if you don't charge tax)
DEFAULT_TAX_PERCENT=0

# Any long random string. Protects the daily keep-alive job. (required on Vercel)
CRON_SECRET=

# Card payments with Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer emails with Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="Your Shop <repairs@your-domain.com>"
EMAIL_REPLY_TO=

# Customer texts with Twilio (optional). Use either a from-number or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Country code for numbers typed without one (1 = US/Canada)
SMS_DEFAULT_COUNTRY_CODE=1
