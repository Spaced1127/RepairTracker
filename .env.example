NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SHOP_NAME=Repair Bench
# IANA time zone used to display timestamps (e.g. America/Chicago)
NEXT_PUBLIC_TIMEZONE=America/New_York

# Server-only key (Project Settings > API > service_role). Needed for customer pay pages and the Stripe webhook.
# Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: online card payments with Stripe. Leave blank to turn them off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Default sales tax percentage for new invoices (0 if you do not charge tax)
DEFAULT_TAX_PERCENT=0

# Customer emails via Resend (resend.com). Leave blank to turn email off.
RESEND_API_KEY=
EMAIL_FROM="Your Shop <repairs@your-domain.com>"
EMAIL_REPLY_TO=
# Customer texts via Twilio. Leave blank to turn texting off. Use either a from-number or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Country code for phone numbers entered without one (1 = US/Canada)
SMS_DEFAULT_COUNTRY_CODE=1

# Any long random string. Protects the daily keep-alive job that stops a free Supabase project from pausing.
# On Vercel, add the same value as an environment variable and Vercel sends it automatically.
CRON_SECRET=
